PORT=8787
AI_UPSTREAM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_UPSTREAM_API_KEY=your_upstream_key_here
AI_UPSTREAM_MODEL=doubao-1.5-lite-32k
# 兼容老配置（可不填）
ZHIPU_API_KEY=
# 可选：设置后，客户端必须在 x-proxy-token 头里带一致的值
APP_PROXY_TOKEN=
# 代理层每月调用上限（服务端总量）
MONTHLY_REQUEST_LIMIT=5000
# JWT 密钥（用于用户身份与会员态校验）
JWT_SECRET=replace_with_strong_secret
# 是否强制每次请求都携带 Bearer JWT（1=强制，0=允许匿名）
REQUIRE_JWT=1
# 普通能力每分钟每用户限流
USER_RATE_LIMIT_PER_MINUTE=20
# 会员专属能力每分钟每用户限流（季度/年度）
PREMIUM_RATE_LIMIT_PER_MINUTE=8
# 限流窗口秒数
GLOBAL_WINDOW_SECONDS=60
# 打印风险日志（1=开启）
RISK_LOG_ENABLED=1
# 上游模型请求超时（毫秒）
AI_UPSTREAM_TIMEOUT_MS=30000
# 月度复盘上游超时（毫秒，默认比普通请求更长）
AI_UPSTREAM_TIMEOUT_MS_MONTHLY=45000
# 可选封面 AI 导演上游硬超时；失败时客户端继续使用本地 Recipe
AI_UPSTREAM_TIMEOUT_MS_COVER_DIRECTOR=8000
