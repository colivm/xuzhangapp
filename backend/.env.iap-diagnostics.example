# Optional, temporary IAP failure diagnostics. Copy ONLY these optional fields
# into the selected server's existing backend/.env; never replace its contents.
# Does NOT change APPLE_APP_STORE_API_BASE_URL or any membership decision.
IAP_DIAGNOSTICS_ENABLED=false
# Exact authenticated phone account to diagnose; keep blank while disabled.
IAP_DIAGNOSTICS_PHONE=
# Explicit ISO-8601 timestamp with timezone; future and <=24h when starting.
IAP_DIAGNOSTICS_EXPIRES_AT=
