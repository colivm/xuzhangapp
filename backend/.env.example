PORT=8790
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_ORIGIN=http://localhost:8080

# AI proxy upstream (your existing service)
AI_PROXY_BASE_URL=http://localhost:8787
AI_PROXY_TOKEN=

# Redis stores SMS verification codes with TTL.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=xuzhang

# Optional: enable dev shortcuts for local testing
DEV_ALLOW_SMS_CODE=

# SMS provider.
# Local/staging can keep SMS_PROVIDER=dev with DEV_ALLOW_SMS_CODE.
# Production should use SMS_PROVIDER=aliyun and leave DEV_ALLOW_SMS_CODE empty.
SMS_PROVIDER=dev
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_COUNTRY_CODE=86
ALIYUN_SMS_SIGN_NAME=叙账
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_MIN=5
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com

# Optional: PostgreSQL (if provided, backend will use DB mode)
# Example: postgres://user:password@127.0.0.1:5432/qingzhang
DATABASE_URL=

# App Store Server API for StoreKit 2 receipt verification.
# Create the key in App Store Connect > Users and Access > Integrations > App Store Server API.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.example.NativeDemoApp
APPLE_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Alternative for platforms that inject secrets directly. Keep real values out of git.
APPLE_PRIVATE_KEY=
# Production: https://api.storekit.itunes.apple.com
# Sandbox: https://api.storekit-sandbox.itunes.apple.com
APPLE_APP_STORE_API_BASE_URL=https://api.storekit-sandbox.itunes.apple.com

# Must match App Store Connect product identifiers and iOS AppSecrets.plist.
IAP_MONTHLY_PRODUCT_ID=com.example.ledger.member.monthly
IAP_YEARLY_PRODUCT_ID=com.example.ledger.member.yearly
IAP_LIFETIME_PRODUCT_ID=com.example.ledger.member.lifetime
