# Staging 环境 backend 配置（复制到服务器 staging 目录后改名为 .env）
# 生成 JWT_SECRET：openssl rand -hex 32（详见 PROJECT_SETUP.md#jwt-secret）

NODE_ENV=staging
PORT=8791
JWT_SECRET=<staging-专用，openssl rand -hex 32 生成，勿与 prod 相同>
ALLOW_ORIGIN=*

AI_PROXY_BASE_URL=http://127.0.0.1:8788
AI_PROXY_TOKEN=
DEV_ALLOW_SMS_CODE=123456
DATABASE_URL=postgres://xuzhang:YOUR_PASSWORD@127.0.0.1:5432/xuzhang-staging
APPLE_APP_STORE_API_BASE_URL=https://api.storekit-sandbox.itunes.apple.com
APPLE_ISSUER_ID=<shared-app-store-server-api-issuer-id>
APPLE_KEY_ID=<shared-app-store-server-api-key-id>
APPLE_BUNDLE_ID=com.xuzhang.app
APPLE_PRIVATE_KEY_PATH=/opt/xuzhang/secrets/AuthKey_<key-id>.p8
IAP_MONTHLY_PRODUCT_ID=com.xuzhang.app.member.monthly
IAP_YEARLY_PRODUCT_ID=com.xuzhang.app.member.yearly
IAP_LIFETIME_PRODUCT_ID=com.xuzhang.app.member.lifetime
