# OPTIONAL: add these keys to each backend's private .env independently.
# Do not replace .env or copy staging/production credentials between environments.
# Default OFF. No real phone, credential or digest belongs in this template.
REVIEW_LOGIN_ENABLED=false
REVIEW_LOGIN_PHONE=
# SHA256 hex digest of an independently generated random 8-12 digit credential.
# Recommend 12 digits. Never reuse DEV_ALLOW_SMS_CODE or a personal account.
REVIEW_LOGIN_CODE_SHA256=
# ISO 8601 with timezone, e.g. YYYY-MM-DDTHH:mm:ss+08:00. Must cover review duration.
REVIEW_LOGIN_EXPIRES_AT=
# Enabling on staging/production requires existing strong JWT_SECRET and REDIS_URL.
# Apply private config changes by restarting every backend worker (including PM2 env).
